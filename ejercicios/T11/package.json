{
  "name": "biblioteca-api",
  "version": "1.0.0",
  "description": "API de Biblioteca con Supabase + Prisma",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/app.js",
    "start": "node --env-file=.env src/app.js",
    "db:studio": "npx prisma studio",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.25.76"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "prisma": "^6.5.0"
  }
}
