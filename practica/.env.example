# Server
PORT=3000
NODE_ENV=development

# MongoDB
DB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/bildyapp

# JWT
JWT_SECRET=tu_secreto_jwt_muy_largo_y_seguro_minimo_32_caracteres
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Uploads
MAX_FILE_SIZE=5242880

# Email (para Nodemailer)
SMTP_HOST=smtp.ethereal.com
SMTP_PORT=587
SMTP_USER=tu_email@ethereal.com
SMTP_PASS=tu_contraseña
SMTP_FROM=tu_email@ethereal.com
SMTP_SECURE=false

# Slack (para logging de errores)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Cloudinary (para subida de firmas y PDFs)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret